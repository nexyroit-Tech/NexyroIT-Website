# Backend API Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://nexyroit.com,https://nexyro-it-website.vercel.app

# Primary LLM API Key (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Secondary LLM API Key (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Google Calendar Integration Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# Vector Database Path
CHROMA_PATH=./chroma_db
